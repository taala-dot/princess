#include <iostream>
#include <vector>
#include <climits>

using namespace std;

const int INF = INT_MAX;

void printMatrix(const vector<vector<int>>& matrix) {
    for (const auto& row : matrix) {
        for (int val : row) {
            if (val == INF)
                cout << "INF ";
            else
                cout << val << " ";
        }
        cout << endl;
    }
}

void floydW(vector<vector<int>>& dist, vector<vector<int>>& next) {
    int n = dist.size();
    for (int i = 0; i < n; ++i) {
        for (int j = 0; j < n; ++j) {
            if (i == j || dist[i][j] == INF)
                next[i][j] = -1;
            else
                next[i][j] = j;
        }
    }

    for (int k = 0; k < n; ++k) {
        for (int i = 0; i < n; ++i) {
            for (int j = 0; j < n; ++j) {
                if (dist[i][k] != INF && dist[k][j] != INF && dist[i][k] + dist[k][j] < dist[i][j]) {
                    dist[i][j] = dist[i][k] + dist[k][j];
                    next[i][j] = next[i][k];
                }
            }
        }
    }
}

void printPath(const vector<vector<int>>& next, int u, int v) {
    if (next[u][v] == -1) {
        cout << "нет пути";
        return;
    }

    cout << u;
    while (u != v) {
        u = next[u][v];
        cout << " -> " << u;
    }
}

int main() {
    int n;
    cout << "кол-во вершин: ";
    cin >> n;

    vector<vector<int>> dist(n, vector<int>(n, INF));
    vector<vector<int>> next(n, vector<int>(n, -1));

    for (int i = 0; i < n; ++i) {
        dist[i][i] = 0;
    }

    cout << "кол-во ребер: ";
    int m;
    cin >> m;

    cout << "ребра :" << endl;
    for (int i = 0; i < m; ++i) {
        int u, v, w;
        cin >> u >> v >> w;
        dist[u][v] = w;
    }

    floydW(dist, next);

    cout << "краткие пути :" << endl;
    printMatrix(dist);

    int start, end;
    cout << "откуда куда: ";
    cin >> start >> end;
    cout << "от " << start << " к " << end << ": ";
    printPath(next, start, end);
    cout << endl;

    return 0;
}
